{
  "name": "runelite-mcp-server-plugin",
  "private": true,
  "description": "Release tooling for the RuneLite MCP Server plugin. The shipped code lives in plugin/ (Java) and server/ (TypeScript); this manifest exists only to pin semantic-release.",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilderness-cloud/runelite-mcp-server-plugin.git"
  },
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "verify:release": "node release/verify-config.mjs && node --test release/*.test.mjs"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.9"
  }
}
